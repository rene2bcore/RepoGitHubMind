# RepoGitHubMind · web (Next.js) para producción.
#
# Multi-stage: instala el monorepo con pnpm, construye `apps/web` con salida
# standalone y copia solo eso a una imagen final sin pnpm, sin código fuente
# y sin dependencias de desarrollo. Corre como `node`, no como root.
#
#   docker build -f docker/Dockerfile.web -t repogithubmind-web .

FROM node:24-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH NEXT_TELEMETRY_DISABLED=1
RUN corepack enable
WORKDIR /app

FROM base AS build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/config/package.json packages/config/
COPY packages/db/package.json packages/db/
COPY packages/github/package.json packages/github/
COPY packages/shared/package.json packages/shared/
# `--ignore-scripts`: el `prepare` de la raíz configura los hooks de git, que
# en la imagen no existen.
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY . .
RUN pnpm --filter web build

FROM node:24-slim AS runtime
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/web/server.js"]
