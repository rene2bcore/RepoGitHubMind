# Producción · copia a docker/.env en el servidor, rellena y `chmod 600 docker/.env`.
# Ningún valor de aquí es real; scripts/verificar-docs.mjs lo comprueba.
# Lo lee docker/docker-compose.prod.yml.

# --- Base de datos. Genera con: openssl rand -hex 24 ---
POSTGRES_PASSWORD=

# --- Sesión. Genera con: openssl rand -base64 32 ---
AUTH_SECRET=
# URL pública con https: la cookie de sesión sale con Secure
AUTH_URL=https://app.example.com
# true detrás de Cloudflare, que escribe cf-connecting-ip (H-07)
TRUST_PROXY=true

# --- GitHub (opcional: amplía el límite de 60 a 5000 peticiones por hora) ---
GITHUB_TOKEN=

# --- IA (H4). Apagada hasta que haya clave; con true y sin AI_API_KEY el worker no arranca ---
# En producción no hay análisis falso: el compose fija AI_FAKE=0.
AI_ANALYSIS_ENABLED=false
AI_PROVIDER=openrouter
# Vacío: google/gemini-2.5-flash-lite (packages/ai/src/defaults.ts, PA-2)
AI_MODEL_ANALYSIS=
# Embeddings de la búsqueda (H5). Vacío: openai/text-embedding-3-small, 1536 dimensiones (packages/ai/src/defaults.ts, PA-3)
AI_EMBEDDING_PROVIDER=openrouter
AI_MODEL_EMBEDDING=
AI_API_KEY=
AI_MAX_README_CHARS=12000
AI_ANALYSIS_TTL_DAYS=90

# --- Cloudflare Tunnel (con --profile tunnel) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Despliegue ---
IMAGE_TAG=latest
WEB_PORT=3000
LOG_LEVEL=info
