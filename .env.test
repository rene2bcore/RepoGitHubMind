# Entorno de pruebas. Lo cargan Vitest y Playwright con `override`: la suite no
# hereda el .env de quien la ejecuta (ADR-0003). Ningún valor es real.
NODE_ENV=test
DATABASE_URL=postgres://rgm:rgm@localhost:5434/repogithubmind
DATABASE_URL_TEST=postgres://rgm:rgm@localhost:5434/repogithubmind_test
AUTH_SECRET=solo-para-pruebas-no-es-un-secreto-real
AUTH_URL=http://localhost:3001
GITHUB_TOKEN=
GITHUB_FAKE=1
AI_ANALYSIS_ENABLED=false
AI_PROVIDER=openrouter
AI_MODEL_ANALYSIS=
AI_EMBEDDING_PROVIDER=openrouter
AI_MODEL_EMBEDDING=
AI_API_KEY=
AI_MAX_README_CHARS=12000
AI_ANALYSIS_TTL_DAYS=90
DEBUG_HTTP_ERRORS=false
LOG_LEVEL=fatal
