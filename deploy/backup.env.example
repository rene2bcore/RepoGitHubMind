# Cloudflare R2 para la copia de los backups fuera del VPS. En el servidor se
# copia a deploy/backup.env con permisos 600. Ningún valor de aquí es real.
# Token de R2 con permiso Object Read & Write limitado al bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=rgm-backups
