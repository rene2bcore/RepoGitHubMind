{
  "name": "repogithubmind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter worker dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check --end-of-line auto .",
    "test": "vitest run",
    "test:e2e": "pnpm --filter web test:e2e",
    "db:generate": "pnpm --filter @rgm/db generate",
    "db:migrate": "pnpm --filter @rgm/db migrate",
    "db:migrate:test": "pnpm --filter @rgm/db migrate:test",
    "db:seed": "pnpm --filter @rgm/db seed",
    "openapi:generate": "pnpm --filter web openapi:generate",
    "openapi:check": "pnpm --filter web openapi:check",
    "prepare": "git config core.hooksPath .githooks",
    "dev:web": "pnpm --filter web dev",
    "dev:worker": "pnpm --filter worker dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.13.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.1.11"
  }
}
