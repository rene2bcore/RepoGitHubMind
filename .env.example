# Copia a .env y rellena. Ningún valor de aquí es real; scripts/verificar-docs.mjs
# lo comprueba. Los secretos no se commitean nunca: .env está en .gitignore.

# --- Base de datos (docker/docker-compose.yml crea las dos) ---
DATABASE_URL=postgres://rgm:rgm@localhost:5434/repogithubmind
DATABASE_URL_TEST=postgres://rgm:rgm@localhost:5434/repogithubmind_test

# --- Auth.js ---
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- GitHub (opcional, amplía el rate limit de la REST API; solo lectura, solo servidor) ---
GITHUB_TOKEN=
# 1 para desarrollar sin red: respuestas grabadas de tres repositorios (packages/github/src/fake.ts)
GITHUB_FAKE=0

# --- IA (proveedor reemplazable; nunca hardcodear modelos; docs/ai-architecture.md) ---
# Con la IA activa, el worker no arranca sin AI_API_KEY: sin clave, AI_FAKE=1 o AI_ANALYSIS_ENABLED=false.
AI_ANALYSIS_ENABLED=true
# 1 para desarrollar sin red ni clave: análisis de prueba (packages/ai/src/fake.ts)
AI_FAKE=0
AI_PROVIDER=openrouter
# Vacío: google/gemini-2.5-flash-lite (packages/ai/src/defaults.ts, PA-2)
AI_MODEL_ANALYSIS=
AI_EMBEDDING_PROVIDER=openrouter
AI_MODEL_EMBEDDING=
AI_API_KEY=
AI_MAX_README_CHARS=12000
AI_ANALYSIS_TTL_DAYS=90

# --- Solo true detrás de un proxy propio (Cloudflare Tunnel), que es quien escribe las cabeceras de dirección (H-07) ---
TRUST_PROXY=false

# --- Depuración. Apagado en todos los entornos (ADR-0004). Encender solo a propósito. ---
DEBUG_HTTP_ERRORS=false
LOG_LEVEL=info
